<view class="fortune-page fortune-page--{{status}}">
  <view class="fortune-glow fortune-glow--top"></view>
  <view class="fortune-glow fortune-glow--bottom"></view>

  <view class="fortune-header">
    <button class="fortune-back" bindtap="goBack">‹</button>
    <view class="fortune-header__copy">
      <text class="fortune-kicker">MEOW ORACLE</text>
      <text class="fortune-title">喵老仙</text>
    </view>
    <view class="fortune-header__seal">喵</view>
  </view>

  <view wx:if="{{status === 'ask'}}" class="fortune-stage fortune-stage--ask">
    <view class="fortune-hero">
      <view class="fortune-halo"></view>
      <image class="fortune-cat" src="{{assets.cat}}" mode="aspectFit" />
      <view class="fortune-spark fortune-spark--one">✦</view>
      <view class="fortune-spark fortune-spark--two">✧</view>
      <view class="fortune-orb fortune-orb--left">☼</view>
      <view class="fortune-orb fortune-orb--right">☾</view>
    </view>
    <view class="fortune-intro">
      <text class="fortune-intro__title">今天想问什么？</text>
      <text class="fortune-intro__desc">把问题交给喵老仙，摇一签听听喵的回答</text>
    </view>
    <view class="fortune-question-card">
      <textarea class="fortune-question" value="{{question}}" maxlength="60" placeholder="比如：这周适合换工作吗？" placeholder-class="fortune-question__placeholder" cursor-spacing="18" bindinput="onQuestionInput"></textarea>
      <view class="fortune-question-card__foot"><text>心诚则灵，问题越具体越好</text><text>{{questionLength}}/60</text></view>
    </view>
    <text wx:if="{{error}}" class="fortune-error">{{error}}</text>
    <button class="fortune-primary" bindtap="askFortune"><text>请喵老仙起卦</text><text class="fortune-primary__arrow">→</text></button>
    <text class="fortune-disclaimer">仅作趣味娱乐，不代替专业建议</text>
  </view>

  <view wx:if="{{status === 'casting'}}" class="fortune-stage fortune-stage--casting">
    <view class="fortune-casting-hero">
      <image class="fortune-cat fortune-cat--casting" src="{{assets.cat}}" mode="aspectFit" />
      <view class="fortune-casting-aura"></view>
    </view>
    <view class="fortune-altar">
      <view class="fortune-altar__top"><text>喵老仙正在起卦</text><text>{{castingStep}} / 3</text></view>
      <view class="fortune-coins">
        <view class="fortune-coin fortune-coin--one {{castingStep >= 1 ? 'is-active' : ''}}">喵</view>
        <view class="fortune-coin fortune-coin--two {{castingStep >= 2 ? 'is-active' : ''}}">喵</view>
        <view class="fortune-coin fortune-coin--three {{castingStep >= 3 ? 'is-active' : ''}}">喵</view>
      </view>
      <text class="fortune-casting-text">{{castingStep === 0 ? '先听听你的心事…' : castingStep === 1 ? '摇动第一枚喵币…' : castingStep === 2 ? '再问天地一声…' : '喵老仙正在解卦…'}}</text>
      <view class="fortune-dots"><view></view><view></view><view></view></view>
    </view>
  </view>

  <view wx:if="{{status === 'result'}}" class="fortune-stage fortune-stage--result">
    <view class="fortune-result-heading"><text class="fortune-result-heading__eyebrow">今日喵签</text><text class="fortune-result-heading__title">喵老仙有话说</text></view>
    <view class="fortune-slip">
      <view class="fortune-slip__seal">喵</view>
      <view class="fortune-slip__symbol">{{result.symbol}}</view>
      <text class="fortune-slip__level">{{result.level}}</text>
      <text class="fortune-slip__sign">{{result.sign}}</text>
      <view class="fortune-slip__divider"><text>✦</text></view>
      <text class="fortune-slip__question">“{{question}}”</text>
      <text class="fortune-slip__text">{{result.text}}</text>
      <view class="fortune-slip__columns">
        <view><text class="fortune-slip__label">今日宜</text><text>{{result.good}}</text></view>
        <view><text class="fortune-slip__label">今日忌</text><text>{{result.avoid}}</text></view>
      </view>
    </view>
    <text class="fortune-disclaimer">这张签只为给今天添一点好心情</text>
    <button class="fortune-primary fortune-primary--result" bindtap="resetFortune">再问一卦 <text class="fortune-primary__arrow">↗</text></button>
  </view>
</view>
