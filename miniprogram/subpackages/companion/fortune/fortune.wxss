page { height:100%; overflow:hidden; background:#11162a; }
.fortune-page { position:relative; display:flex; flex-direction:column; height:100vh; min-height:0; overflow:hidden; box-sizing:border-box; padding:calc(env(safe-area-inset-top) + 22rpx) 30rpx calc(env(safe-area-inset-bottom) + 24rpx); background:radial-gradient(circle at 50% 28%,rgba(255,194,77,.13),transparent 28%),linear-gradient(180deg,#12182c 0%,#191d35 58%,#111528 100%); color:#fff; }
.fortune-glow { position:absolute; width:460rpx; height:460rpx; pointer-events:none; border-radius:50%; filter:blur(2rpx); opacity:.44; }
.fortune-glow--top { top:60rpx; left:-270rpx; background:radial-gradient(circle,rgba(246,110,156,.3),transparent 68%); }
.fortune-glow--bottom { right:-270rpx; bottom:-130rpx; background:radial-gradient(circle,rgba(255,194,77,.24),transparent 68%); }
.fortune-header { position:relative; z-index:2; display:flex; align-items:center; justify-content:space-between; flex:0 0 auto; height:72rpx; }
.fortune-back { display:flex; align-items:center; justify-content:center; width:68rpx; height:68rpx; margin:0; padding:0 0 8rpx; border:1rpx solid rgba(255,255,255,.18); border-radius:50%; background:rgba(255,255,255,.08); color:#fff; font-size:54rpx; font-weight:300; line-height:1; }
.fortune-back::after { border:0; }
.fortune-header__copy { display:flex; align-items:center; flex-direction:column; }
.fortune-kicker { color:#f8c75c; font-size:15rpx; font-weight:800; letter-spacing:4rpx; }
.fortune-title { margin-top:3rpx; color:#fff6d2; font-size:30rpx; font-weight:900; letter-spacing:2rpx; }
.fortune-header__seal { display:flex; align-items:center; justify-content:center; width:54rpx; height:54rpx; border:2rpx solid rgba(255,208,92,.75); border-radius:18rpx 22rpx 18rpx 22rpx; color:#ffd670; font-size:23rpx; font-weight:900; transform:rotate(8deg); }
.fortune-stage { position:relative; z-index:1; display:flex; flex:1 1 auto; min-height:0; flex-direction:column; align-items:center; }
.fortune-stage--ask { justify-content:space-between; padding:5rpx 0 0; }
.fortune-hero { position:relative; width:100%; height:400rpx; flex:none; }
.fortune-halo { position:absolute; top:62rpx; left:50%; width:360rpx; height:280rpx; border-radius:50%; background:radial-gradient(ellipse,rgba(255,204,89,.3),rgba(246,110,156,.08) 52%,transparent 72%); transform:translateX(-50%); }
.fortune-cat { position:relative; z-index:2; display:block; width:100%; height:100%; }
.fortune-hero .fortune-cat { animation:fortune-cat-float 3.6s ease-in-out infinite; }
.fortune-spark { position:absolute; z-index:3; color:#ffd56d; font-size:42rpx; text-shadow:0 0 20rpx rgba(255,203,88,.72); animation:fortune-spark 2.4s ease-in-out infinite; }
.fortune-spark--one { top:104rpx; left:80rpx; }
.fortune-spark--two { top:192rpx; right:74rpx; animation-delay:1s; color:#f59cc0; font-size:34rpx; }
.fortune-orb { position:absolute; z-index:3; display:flex; align-items:center; justify-content:center; width:56rpx; height:56rpx; border:2rpx solid rgba(255,219,123,.42); border-radius:50%; background:rgba(255,205,92,.1); color:#ffd56d; font-size:25rpx; }
.fortune-orb--left { top:270rpx; left:54rpx; }
.fortune-orb--right { top:76rpx; right:50rpx; color:#f7aaca; }
.fortune-intro { display:flex; align-items:center; flex-direction:column; margin-top:-12rpx; }
.fortune-intro__title { color:#fff; font-size:34rpx; font-weight:900; letter-spacing:1rpx; }
.fortune-intro__desc { margin-top:8rpx; color:rgba(255,255,255,.56); font-size:18rpx; }
.fortune-question-card { width:100%; margin-top:18rpx; padding:20rpx 22rpx 14rpx; box-sizing:border-box; border:1rpx solid rgba(255,212,113,.25); border-radius:26rpx; background:linear-gradient(145deg,rgba(255,255,255,.11),rgba(255,255,255,.055)); box-shadow:0 14rpx 32rpx rgba(0,0,0,.16); }
.fortune-question { width:100%; height:92rpx; box-sizing:border-box; color:#fff; font-size:21rpx; line-height:1.5; }
.fortune-question__placeholder { color:rgba(255,255,255,.38); }
.fortune-question-card__foot { display:flex; justify-content:space-between; margin-top:5rpx; color:rgba(255,255,255,.4); font-size:15rpx; }
.fortune-error { margin-top:8rpx; color:#ffb9c8; font-size:16rpx; }
.fortune-primary { display:flex; align-items:center; justify-content:center; width:100%; height:82rpx; margin:14rpx 0 0; padding:0; border:0; border-radius:999rpx; background:linear-gradient(100deg,#f66e9c,#ffb84c); color:#fff; font-size:23rpx; font-weight:900; box-shadow:0 12rpx 26rpx rgba(246,110,156,.25); }
.fortune-primary::after { border:0; }
.fortune-primary__arrow { margin-left:16rpx; font-size:31rpx; font-weight:400; }
.fortune-disclaimer { color:rgba(255,255,255,.38); font-size:14rpx; text-align:center; }
.fortune-stage--ask .fortune-disclaimer { margin-top:8rpx; }
.fortune-stage--casting { justify-content:center; padding-bottom:60rpx; }
.fortune-casting-hero { position:relative; width:100%; height:430rpx; }
.fortune-cat--casting { animation:fortune-casting 1.3s ease-in-out infinite; }
.fortune-casting-aura { position:absolute; top:72rpx; left:50%; width:340rpx; height:260rpx; border-radius:50%; background:radial-gradient(ellipse,rgba(255,203,88,.34),transparent 69%); transform:translateX(-50%); animation:fortune-pulse 1.4s ease-in-out infinite; }
.fortune-altar { position:relative; width:100%; padding:24rpx 26rpx 22rpx; box-sizing:border-box; border:1rpx solid rgba(255,207,93,.3); border-radius:32rpx; background:linear-gradient(145deg,rgba(255,255,255,.12),rgba(255,255,255,.045)); box-shadow:0 18rpx 40rpx rgba(0,0,0,.22); text-align:center; }
.fortune-altar__top { display:flex; justify-content:space-between; color:#ffe4a0; font-size:17rpx; }
.fortune-altar__top text:last-child { color:rgba(255,255,255,.46); }
.fortune-coins { display:flex; justify-content:center; gap:28rpx; height:150rpx; margin-top:8rpx; }
.fortune-coin { display:flex; align-items:center; justify-content:center; width:88rpx; height:88rpx; margin-top:34rpx; border:5rpx solid #f7c858; border-radius:50%; background:radial-gradient(circle at 35% 30%,#ffe9a1,#d89422 64%,#956019); box-shadow:0 8rpx 18rpx rgba(0,0,0,.28),inset 0 0 0 4rpx rgba(255,246,191,.34); color:#fff1bb; font-size:26rpx; font-weight:900; transform:rotate(18deg); }
.fortune-coin.is-active { animation:fortune-coin-toss .72s ease-in-out both; }
.fortune-coin--two { transform:rotate(-28deg); animation-delay:.12s; }
.fortune-coin--three { transform:rotate(9deg); animation-delay:.24s; }
.fortune-casting-text { display:block; color:#fff; font-size:22rpx; font-weight:800; }
.fortune-dots { display:flex; justify-content:center; gap:8rpx; margin-top:14rpx; }
.fortune-dots view { width:8rpx; height:8rpx; border-radius:50%; background:#f7c858; animation:fortune-dot 1.2s ease-in-out infinite; }
.fortune-dots view:nth-child(2) { animation-delay:.18s; }
.fortune-dots view:nth-child(3) { animation-delay:.36s; }
.fortune-stage--result { justify-content:space-between; padding:24rpx 0 0; }
.fortune-result-heading { display:flex; align-items:center; flex-direction:column; }
.fortune-result-heading__eyebrow { color:#f6c65b; font-size:17rpx; letter-spacing:4rpx; }
.fortune-result-heading__title { margin-top:7rpx; color:#fff; font-size:29rpx; font-weight:900; }
.fortune-slip { position:relative; width:100%; min-height:620rpx; padding:50rpx 36rpx 32rpx; box-sizing:border-box; border:2rpx solid rgba(255,215,128,.75); border-radius:20rpx 20rpx 30rpx 30rpx; background:linear-gradient(155deg,#fff7dc 0%,#ffe9b8 100%); box-shadow:0 18rpx 36rpx rgba(0,0,0,.24),inset 0 0 0 8rpx rgba(255,255,255,.32); color:#5c3a27; animation:fortune-result-reveal .55s ease-out both; }
.fortune-slip::before,.fortune-slip::after { position:absolute; width:28rpx; height:28rpx; border:2rpx solid rgba(155,94,43,.3); content:''; }
.fortune-slip::before { top:22rpx; left:22rpx; border-width:2rpx 0 0 2rpx; }
.fortune-slip::after { right:22rpx; bottom:22rpx; border-width:0 2rpx 2rpx 0; }
.fortune-slip__seal { position:absolute; top:22rpx; right:26rpx; display:flex; align-items:center; justify-content:center; width:54rpx; height:54rpx; border:2rpx solid #c14d50; border-radius:16rpx; color:#c14d50; font-size:22rpx; font-weight:900; transform:rotate(8deg); }
.fortune-slip__symbol { display:flex; align-items:center; justify-content:center; width:100rpx; height:100rpx; margin:0 auto 4rpx; border:4rpx solid #d99a36; border-radius:50%; color:#d28d29; font-size:58rpx; }
.fortune-slip__level { display:block; color:#a66a2b; font-size:20rpx; font-weight:800; text-align:center; letter-spacing:3rpx; }
.fortune-slip__sign { display:block; margin-top:8rpx; color:#6d3825; font-size:39rpx; font-weight:900; text-align:center; }
.fortune-slip__divider { display:flex; align-items:center; justify-content:center; margin:16rpx 0; color:#d59733; font-size:20rpx; }
.fortune-slip__divider::before,.fortune-slip__divider::after { width:130rpx; height:1rpx; background:rgba(174,111,38,.34); content:''; }
.fortune-slip__divider text { margin:0 12rpx; }
.fortune-slip__question { display:block; overflow:hidden; color:#9b704b; font-size:17rpx; text-overflow:ellipsis; white-space:nowrap; text-align:center; }
.fortune-slip__text { display:block; margin-top:16rpx; color:#62402c; font-size:21rpx; line-height:1.72; text-align:center; }
.fortune-slip__columns { display:flex; gap:16rpx; margin-top:22rpx; }
.fortune-slip__columns>view { flex:1; padding:14rpx 13rpx; border-radius:16rpx; background:rgba(255,255,255,.42); font-size:16rpx; line-height:1.55; }
.fortune-slip__columns>view>text:last-child { display:block; margin-top:5rpx; }
.fortune-slip__label { display:block; color:#ba6c38; font-size:17rpx; font-weight:900; }
.fortune-stage--result .fortune-disclaimer { margin-top:10rpx; }
.fortune-primary--result { margin-top:10rpx; }
@keyframes fortune-cat-float { 0%,100% { transform:translateY(0) rotate(-1deg); } 50% { transform:translateY(-9rpx) rotate(1deg); } }
@keyframes fortune-spark { 0%,100% { opacity:.45; transform:scale(.82) rotate(0); } 50% { opacity:1; transform:scale(1.16) rotate(18deg); } }
@keyframes fortune-casting { 0%,100% { transform:rotate(-2deg) translateY(0); } 50% { transform:rotate(2deg) translateY(-10rpx); } }
@keyframes fortune-pulse { 0%,100% { opacity:.52; transform:translateX(-50%) scale(.92); } 50% { opacity:1; transform:translateX(-50%) scale(1.1); } }
@keyframes fortune-coin-toss { 0% { transform:translateY(0) rotate(0); } 45% { transform:translateY(-44rpx) rotate(160deg); } 100% { transform:translateY(0) rotate(360deg); } }
@keyframes fortune-dot { 0%,100% { opacity:.35; transform:translateY(0); } 50% { opacity:1; transform:translateY(-5rpx); } }
@keyframes fortune-result-reveal { from { opacity:0; transform:translateY(26rpx) scale(.96); } to { opacity:1; transform:translateY(0) scale(1); } }
@media (max-height: 740px) { .fortune-hero { height:330rpx; } .fortune-question { height:74rpx; } .fortune-slip { min-height:550rpx; padding-top:36rpx; } .fortune-slip__text { margin-top:10rpx; } .fortune-slip__columns { margin-top:14rpx; } }
