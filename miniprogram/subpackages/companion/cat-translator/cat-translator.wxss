page { background: #f8f7fb; }
.translator-page { box-sizing: border-box; width: 100%; height: 100vh; min-height: 100vh; padding: 0 28rpx; overflow: hidden; color: #20243c; background: linear-gradient(180deg, #b8d7ff 0, #eaf3ff 420rpx, #f8f7fb 820rpx); }
.translator-topbar { display: flex; align-items: center; height: 150rpx; padding-top: env(safe-area-inset-top); }
.translator-back { display: flex; align-items: center; justify-content: center; width: 74rpx; height: 64rpx; padding: 0; border: 2rpx solid #fff; border-radius: 999rpx; background: rgba(255,255,255,.8); color: #3d2a72; font-size: 54rpx; font-weight: 300; line-height: 1; }
.translator-heading { flex: 1; padding-left: 22rpx; }
.translator-eyebrow, .translator-intro__title, .result-card__eyebrow { display: block; }
.translator-eyebrow { color: #5579b8; font-size: 18rpx; letter-spacing: 3rpx; }
.translator-title { display: block; margin-top: 4rpx; color: #3d2a72; font-size: 38rpx; font-weight: 850; }
.translator-top-icon { width: 78rpx; height: 78rpx; }
.translator-scroll { height: calc(100vh - 150rpx); padding-bottom: calc(32rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.translator-intro, .video-card, .result-card, .status-card, .error-card { border: 3rpx solid #fff; box-shadow: 0 12rpx 26rpx rgba(73,93,145,.1); }
.translator-intro { display: flex; align-items: center; padding: 24rpx; border-radius: 28rpx; background: rgba(255,255,255,.82); }
.translator-intro__icon { width: 116rpx; height: 116rpx; flex: none; }
.translator-intro__copy { margin-left: 16rpx; }
.translator-intro__title { color: #3d2a72; font-size: 30rpx; font-weight: 800; }
.translator-intro__desc { display: block; margin-top: 8rpx; color: #75809a; font-size: 22rpx; line-height: 1.5; }
.direction-tabs { display: flex; gap: 8rpx; margin-top: 18rpx; padding: 7rpx; border-radius: 999rpx; background: rgba(255,255,255,.62); }
.direction-tab { flex: 1; height: 62rpx; padding: 0; border-radius: 999rpx; background: transparent; color: #75809a; font-size: 21rpx; line-height: 62rpx; }
.direction-tab--active { background: #fff; color: #3d2a72; font-weight: 800; box-shadow: 0 5rpx 12rpx rgba(73,93,145,.1); }
.video-card { position: relative; min-height: 390rpx; margin-top: 20rpx; overflow: hidden; border-radius: 28rpx; background: #20243c; }
.video-card__player { display: block; width: 100%; height: 470rpx; }
.video-card__image { display: block; width: 100%; height: 470rpx; }
.video-card__empty { display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 390rpx; padding: 28rpx; color: #fff; text-align: center; }
.video-card__empty image { width: 188rpx; height: 188rpx; margin-bottom: 12rpx; }
.video-card__empty text { font-size: 25rpx; }
.video-card__hint { margin-top: 8rpx; color: rgba(255,255,255,.62); font-size: 20rpx !important; }
.video-card__remove { position: absolute; top: 18rpx; right: 18rpx; padding: 10rpx 18rpx; border: 2rpx solid rgba(255,255,255,.75); border-radius: 999rpx; background: rgba(32,36,60,.72); color: #fff; font-size: 20rpx; }
.video-card__meta { display: flex; justify-content: space-between; padding: 13rpx 20rpx; background: rgba(32,36,60,.86); color: rgba(255,255,255,.78); font-size: 19rpx; }
.source-actions { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 18rpx; }
.media-kind-tabs { display: flex; width: 100%; gap: 8rpx; padding: 6rpx; border-radius: 999rpx; background: rgba(255,255,255,.65); }
.media-kind-tab { flex: 1; height: 56rpx; padding: 0; border-radius: 999rpx; background: transparent; color: #75809a; font-size: 21rpx; line-height: 56rpx; }
.media-kind-tab--active { background: #fff; color: #3d2a72; font-weight: 800; box-shadow: 0 5rpx 12rpx rgba(73,93,145,.1); }
.source-action { display: flex; flex: 1; align-items: center; justify-content: center; height: 82rpx; padding: 0; border: 2rpx solid #fff; border-radius: 22rpx; background: rgba(255,255,255,.78); color: #3d2a72; font-size: 23rpx; }
.source-action image { width: 54rpx; height: 54rpx; margin-right: 10rpx; }
.analyze-button { width: 100%; height: 88rpx; margin-top: 18rpx; border: 3rpx solid #fff; border-radius: 999rpx; background: #f66e9c; color: #fff; font-size: 28rpx; font-weight: 800; line-height: 82rpx; box-shadow: 0 10rpx 22rpx rgba(246,110,156,.25); }
.analyze-button--disabled { background: #d7dced; box-shadow: none; }
.audio-capture-card, .speech-capture-card, .speech-result-card { margin-top: 20rpx; padding: 24rpx; border: 3rpx solid #fff; border-radius: 28rpx; background: rgba(255,255,255,.88); box-shadow: 0 12rpx 26rpx rgba(73,93,145,.1); }
.audio-capture-card { display: flex; flex-direction: column; align-items: center; text-align: center; }
.audio-capture-card image { width: 190rpx; height: 190rpx; }
.audio-capture-card__title, .speech-capture-card__title { display: block; color: #3d2a72; font-size: 28rpx; font-weight: 800; }
.audio-capture-card__desc, .speech-capture-card__hint { display: block; margin-top: 8rpx; color: #85899b; font-size: 20rpx; line-height: 1.5; }
.record-button { min-width: 280rpx; height: 82rpx; margin-top: 20rpx; border: 3rpx solid #fff; border-radius: 999rpx; background: #f66e9c; color: #fff; font-size: 24rpx; font-weight: 800; line-height: 76rpx; }
.record-button--recording { background: #d84e80; }
.speech-capture-card__head { display: flex; align-items: baseline; justify-content: space-between; }
.speech-input { box-sizing: border-box; width: 100%; min-height: 180rpx; margin-top: 18rpx; padding: 18rpx; border: 2rpx solid #e5e9f5; border-radius: 20rpx; background: #f8f9ff; color: #20243c; font-size: 24rpx; line-height: 1.55; }
.speech-actions { display: flex; gap: 12rpx; margin-top: 16rpx; }
.record-speech, .speech-submit { flex: 1; height: 78rpx; padding: 0; border-radius: 999rpx; font-size: 22rpx; line-height: 74rpx; }
.record-speech { border: 2rpx solid #f5a9c9; background: #fff5f9; color: #d84e80; }
.speech-submit { border: 2rpx solid #fff; background: #f66e9c; color: #fff; font-weight: 800; }
.speech-submit[disabled] { background: #d7dced; }
.inline-error { display: block; margin-top: 14rpx; color: #a94f70; font-size: 19rpx; line-height: 1.45; }
.status-card, .error-card { display: flex; align-items: center; margin-top: 18rpx; padding: 20rpx; border-radius: 24rpx; background: rgba(255,255,255,.88); }
.status-card image { width: 88rpx; height: 88rpx; margin-right: 14rpx; }
.status-card__title { display: block; color: #3d2a72; font-size: 25rpx; font-weight: 800; }
.status-card__desc { display: block; margin-top: 6rpx; color: #75809a; font-size: 20rpx; line-height: 1.45; }
.error-card { justify-content: space-between; color: #a94f70; font-size: 22rpx; }
.error-card button { margin: 0 0 0 16rpx; padding: 9rpx 18rpx; border-radius: 999rpx; background: #fff0f5; color: #d84e80; font-size: 20rpx; }
.result-card { margin-top: 20rpx; padding: 24rpx; border-radius: 28rpx; background: rgba(255,255,255,.92); }
.result-card__head { display: flex; align-items: flex-start; justify-content: space-between; }
.result-card__eyebrow { color: #f66e9c; font-size: 16rpx; letter-spacing: 2rpx; }
.result-card__title { display: block; margin-top: 5rpx; color: #3d2a72; font-size: 34rpx; font-weight: 850; }
.confidence { display: flex; flex-direction: column; align-items: flex-end; color: #5579b8; }
.confidence text:first-child { color: #f66e9c; font-size: 34rpx; font-weight: 850; }
.confidence text:last-child { margin-top: 2rpx; color: #85899b; font-size: 18rpx; }
.result-summary { display: block; margin-top: 18rpx; color: #505a78; font-size: 24rpx; line-height: 1.6; }
.signal-list { margin-top: 18rpx; padding: 6rpx 18rpx; border-radius: 18rpx; background: #f4f6ff; }
.signal-row { display: flex; padding: 15rpx 0; border-bottom: 1rpx solid #e5e9f5; font-size: 21rpx; }
.signal-row:last-child { border-bottom: 0; }
.signal-row__label { width: 130rpx; flex: none; color: #f66e9c; font-weight: 700; }
.signal-row__value { color: #505a78; line-height: 1.45; }
.suggestion { margin-top: 18rpx; padding: 16rpx 18rpx; border-radius: 18rpx; background: #fff7d9; color: #6d5b28; font-size: 21rpx; line-height: 1.55; }
.suggestion__label { display: block; margin-bottom: 5rpx; color: #b58b22; font-weight: 800; }
.result-disclaimer { display: block; margin-top: 16rpx; color: #9aa1b3; font-size: 17rpx; line-height: 1.5; }
.speech-result-card__text { display: block; margin-top: 16rpx; color: #3d2a72; font-size: 32rpx; font-weight: 800; line-height: 1.5; }
.speech-result-card__meaning { display: block; margin-top: 8rpx; color: #75809a; font-size: 21rpx; line-height: 1.5; }
.play-speech { width: 100%; height: 84rpx; margin-top: 20rpx; border: 3rpx solid #fff; border-radius: 999rpx; background: #2557d6; color: #fff; font-size: 25rpx; font-weight: 800; line-height: 78rpx; }
.play-speech--playing { background: #3d2a72; }
