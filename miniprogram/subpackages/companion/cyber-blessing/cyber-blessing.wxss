page { height:100%; background:#27335c; }
.blessing-page { position:relative; display:flex; flex-direction:column; min-height:100vh; box-sizing:border-box; overflow:auto; padding:calc(env(safe-area-inset-top) + 20rpx) 26rpx calc(env(safe-area-inset-bottom) + 28rpx); color:#fff8eb; background:#27335c; }
.blessing-background,.blessing-background__veil { position:absolute; inset:0; width:100%; height:100%; }
.blessing-background { z-index:0; opacity:.96; }
.blessing-background__veil { z-index:0; background:linear-gradient(180deg,rgba(25,34,69,.36) 0%,rgba(35,46,84,.12) 36%,rgba(26,31,63,.8) 73%,#1f294d 100%); }
.blessing-header { position:relative; z-index:2; display:flex; align-items:center; justify-content:space-between; height:74rpx; flex:0 0 auto; }
.blessing-back { display:flex; align-items:center; justify-content:center; width:66rpx; height:66rpx; margin:0; padding:0 0 8rpx; border:2rpx solid rgba(255,255,255,.56); border-radius:50%; background:rgba(21,31,66,.42); color:#fff8eb; font-size:54rpx; font-weight:300; line-height:1; }
.blessing-back::after { border:0; }
.blessing-header__copy { display:flex; align-items:center; flex-direction:column; }
.blessing-kicker { color:#ffe18a; font-size:14rpx; font-weight:800; letter-spacing:4rpx; }
.blessing-title { margin-top:4rpx; color:#fff8eb; font-size:30rpx; font-weight:900; letter-spacing:1rpx; text-shadow:0 2rpx 12rpx rgba(20,24,52,.3); }
.blessing-header__coin { display:flex; align-items:center; justify-content:center; gap:3rpx; min-width:82rpx; height:54rpx; padding:0 10rpx; box-sizing:border-box; border:2rpx solid rgba(255,255,255,.62); border-radius:999rpx; background:rgba(21,31,66,.44); color:#ffe18a; font-size:16rpx; font-weight:900; }
.blessing-header__coin image { width:34rpx; height:34rpx; }
.blessing-scene { position:relative; z-index:1; display:flex; align-items:center; flex-direction:column; min-height:628rpx; padding-top:28rpx; }
.blessing-scene__title { display:flex; align-items:center; flex-direction:column; text-shadow:0 2rpx 12rpx rgba(20,24,52,.42); }
.blessing-scene__title text:first-child { font-size:31rpx; font-weight:900; letter-spacing:1rpx; }
.blessing-scene__title text:last-child { margin-top:8rpx; color:rgba(255,248,235,.72); font-size:16rpx; }
.blessing-cat-wrap { position:relative; width:100%; height:640rpx; margin-top:4rpx; }
.blessing-cat-glow { position:absolute; top:350rpx; left:50%; width:390rpx; height:170rpx; border-radius:50%; background:radial-gradient(ellipse,rgba(255,216,112,.55),rgba(255,144,185,.14) 52%,transparent 76%); transform:translateX(-50%); filter:blur(3rpx); }
.blessing-cat-viewport { position:absolute; top:0; right:0; bottom:0; left:0; z-index:1; background-repeat:no-repeat; background-size:500% auto; background-position:0 center; animation:none; will-change:background-position; }
.blessing-cat-viewport.is-playing { animation:cat-knock-loop 1.8s steps(4,end) infinite; }
.blessing-knock-reward { position:absolute; z-index:3; top:126rpx; right:100rpx; color:#ffe18a; font-size:32rpx; font-weight:900; opacity:0; transform:translateY(10rpx) scale(.8); transition:opacity 100ms ease-out,transform 300ms ease-out; text-shadow:0 2rpx 14rpx rgba(35,26,65,.6); }
.blessing-knock-reward.is-visible { opacity:1; transform:translateY(-34rpx) scale(1); }
.blessing-count-card { display:flex; align-items:center; justify-content:space-between; width:100%; padding:18rpx 22rpx; box-sizing:border-box; border:2rpx solid rgba(255,255,255,.25); border-radius:24rpx; background:rgba(20,29,64,.58); box-shadow:0 12rpx 28rpx rgba(15,17,45,.22); }
.blessing-count-card>view:first-child { display:flex; flex-direction:column; }
.blessing-count-card__label { color:rgba(255,248,235,.68); font-size:15rpx; }
.blessing-count-card__value { margin-top:4rpx; color:#fff8eb; font-size:32rpx; font-weight:900; }
.blessing-count-card__value text { color:#ffe18a; font-size:15rpx; font-weight:500; }
.blessing-count-card__status { display:flex; align-items:center; color:#ffe18a; font-size:15rpx; }
.blessing-live-dot { width:12rpx; height:12rpx; margin-right:9rpx; border-radius:50%; background:#f66e9c; box-shadow:0 0 14rpx rgba(246,110,156,.9); animation:live-pulse 1.2s ease-in-out infinite; }
.blessing-panel { position:relative; z-index:2; width:100%; margin-top:-2rpx; padding:24rpx 22rpx calc(22rpx + env(safe-area-inset-bottom)); box-sizing:border-box; border:2rpx solid rgba(255,255,255,.76); border-radius:30rpx; background:rgba(248,247,251,.94); color:#20243c; box-shadow:0 -12rpx 32rpx rgba(18,23,54,.18); }
.blessing-panel__heading { display:flex; flex-direction:column; }
.blessing-panel__heading text:first-child { color:#3f327b; font-size:25rpx; font-weight:900; }
.blessing-panel__heading text:last-child { margin-top:7rpx; color:#85899b; font-size:16rpx; }
.blessing-incense-button { display:flex; align-items:center; width:100%; min-height:88rpx; margin:18rpx 0 0; padding:10rpx 14rpx 10rpx 4rpx; box-sizing:border-box; border:0; border-radius:22rpx; background:linear-gradient(100deg,#f66e9c,#f5b74e); color:#fff; text-align:left; box-shadow:0 12rpx 24rpx rgba(246,110,156,.23); }
.blessing-incense-button::after { border:0; }
.blessing-incense-button image { width:104rpx; height:78rpx; margin-right:7rpx; object-fit:contain; }
.blessing-incense-button>view { display:flex; flex:1; flex-direction:column; }
.blessing-incense-button>view text:first-child { font-size:20rpx; font-weight:900; }
.blessing-incense-button>view text:last-child { margin-top:5rpx; color:rgba(255,255,255,.8); font-size:14rpx; }
.blessing-incense-button__arrow { padding-right:7rpx; font-size:30rpx; font-weight:300; }
.blessing-note { display:block; margin-top:10rpx; color:#85899b; font-size:13rpx; text-align:center; }
.blessing-panel__burning { display:flex; align-items:center; flex-direction:column; min-height:150rpx; justify-content:center; }
.blessing-incense-smoke { display:flex; justify-content:center; gap:20rpx; height:38rpx; }
.blessing-incense-smoke view { width:11rpx; height:28rpx; border-radius:50%; background:#c3a9df; opacity:.42; animation:smoke-rise 1.6s ease-in-out infinite; }
.blessing-incense-smoke view:nth-child(2) { animation-delay:.3s; }
.blessing-incense-smoke view:nth-child(3) { animation-delay:.6s; }
.blessing-burning-title { color:#3f327b; font-size:24rpx; font-weight:900; }
.blessing-burning-desc { margin-top:6rpx; color:#85899b; font-size:15rpx; }
.blessing-progress { width:78%; height:10rpx; margin-top:20rpx; overflow:hidden; border-radius:999rpx; background:#ebeaf2; }
.blessing-progress view { height:100%; border-radius:inherit; background:linear-gradient(90deg,#f66e9c,#f5b74e); transition:width .5s ease; }
.blessing-result-head { display:flex; align-items:center; justify-content:space-between; }
.blessing-result-head view { display:flex; flex-direction:column; }
.blessing-result-head view text:first-child { color:#3f327b; font-size:24rpx; font-weight:900; }
.blessing-result-head view text:last-child { margin-top:5rpx; color:#85899b; font-size:15rpx; }
.blessing-result-stamp { padding:8rpx 12rpx; border:2rpx solid #f5a9c9; border-radius:999rpx; color:#e65d91; font-size:14rpx; }
.blessing-slip { position:relative; margin-top:18rpx; padding:34rpx 22rpx 20rpx; box-sizing:border-box; border:2rpx solid #f2c36d; border-radius:20rpx 20rpx 28rpx 28rpx; background:linear-gradient(145deg,#fff9e8,#fff0c8); color:#69442d; box-shadow:inset 0 0 0 7rpx rgba(255,255,255,.38); }
.blessing-slip__stamp { position:absolute; top:17rpx; right:18rpx; display:flex; align-items:center; justify-content:center; width:45rpx; height:45rpx; border:2rpx solid #f66e9c; border-radius:14rpx; color:#f66e9c; font-size:19rpx; font-weight:900; transform:rotate(8deg); }
.blessing-slip__eyebrow { display:block; color:#b78338; font-size:13rpx; font-weight:800; letter-spacing:3rpx; text-align:center; }
.blessing-slip__title { display:block; margin-top:8rpx; color:#69442d; font-size:32rpx; font-weight:900; text-align:center; }
.blessing-slip__text { display:block; margin-top:12rpx; color:#694b36; font-size:17rpx; line-height:1.65; text-align:center; }
.blessing-slip__columns { display:flex; gap:10rpx; margin-top:16rpx; }
.blessing-slip__columns>view { flex:1; padding:10rpx; border-radius:13rpx; background:rgba(255,255,255,.46); font-size:14rpx; line-height:1.5; }
.blessing-slip__columns>view text:first-child { display:block; color:#c78344; font-weight:900; }
.blessing-slip__columns>view text:last-child { display:block; margin-top:4rpx; }
.blessing-secondary { display:flex; align-items:center; justify-content:center; gap:10rpx; width:100%; height:68rpx; margin:13rpx 0 0; padding:0; border:2rpx solid rgba(246,110,156,.55); border-radius:999rpx; background:#fff; color:#f05f92; font-size:18rpx; font-weight:800; }
.blessing-secondary::after { border:0; }
.blessing-secondary text { font-size:28rpx; font-weight:400; }
@keyframes cat-knock-loop { 0% { background-position:0 center; } 100% { background-position:100% center; } }
@keyframes live-pulse { 0%,100% { opacity:.45; transform:scale(.8); } 50% { opacity:1; transform:scale(1.15); } }
@keyframes smoke-rise { 0% { opacity:.15; transform:translateY(12rpx) scale(.7); } 50% { opacity:.7; transform:translateY(-6rpx) scale(1); } 100% { opacity:0; transform:translateY(-22rpx) scale(1.2); } }
@media (max-height: 740px) { .blessing-scene { min-height:720rpx; padding-top:14rpx; } .blessing-cat-wrap { height:560rpx; } .blessing-cat-glow { top:292rpx; } .blessing-knock-reward { top:145rpx; } .blessing-panel { padding-top:18rpx; } }
