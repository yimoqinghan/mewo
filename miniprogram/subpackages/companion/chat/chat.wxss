page { background: #f8f7fb; }
.chat-page { display: flex; flex-direction: column; box-sizing: border-box; width: 100%; height: 100vh; min-height: 100vh; overflow: hidden; padding: 0 28rpx; background: linear-gradient(180deg, #b8d7ff 0, #eaf3ff 330rpx, #f8f7fb 650rpx); color: #20243c; }
.chat-topbar { display: flex; align-items: center; height: 150rpx; padding-top: env(safe-area-inset-top); }
.back-button, .clear-button { display: flex; align-items: center; justify-content: center; min-width: 76rpx; height: 64rpx; padding: 0; border: 2rpx solid #fff; border-radius: 999rpx; background: rgba(255,255,255,.76); color: #20243c; }
.back-button { font-size: 54rpx; font-weight: 300; line-height: 1; }
.clear-button { margin-left: auto; color: #7c84a0; font-size: 21rpx; }
.chat-heading { flex: 1; padding-left: 22rpx; }
.chat-heading__eyebrow { display: block; color: #5579b8; font-size: 18rpx; letter-spacing: 3rpx; }
.chat-heading__title { display: block; margin-top: 5rpx; color: #3d2a72; font-size: 38rpx; font-weight: 850; }
.chat-lock { display: flex; flex-direction: column; align-items: center; margin-top: 110rpx; padding: 44rpx 40rpx 36rpx; border: 3rpx solid #fff; border-radius: 30rpx; background: rgba(255,255,255,.88); text-align: center; box-shadow: 0 16rpx 34rpx rgba(73,93,145,.12); }
.lock-cat-wrap { display: flex; align-items: center; justify-content: center; width: 170rpx; height: 170rpx; margin-bottom: 22rpx; border-radius: 50%; background: #ffe27a; }
.lock-cat-wrap image { width: 150rpx; height: 150rpx; }
.lock-title { color: #3d2a72; font-size: 34rpx; font-weight: 800; }
.lock-desc { margin-top: 14rpx; color: #75809a; font-size: 23rpx; line-height: 1.65; }
.primary-button { width: 100%; margin-top: 28rpx; border: 3rpx solid #fff; border-radius: 999rpx; background: #ffe27a; color: #3d2a72; font-size: 27rpx; font-weight: 800; line-height: 86rpx; }
.text-button { margin-top: 14rpx; padding: 0 20rpx; background: transparent; color: #2557d6; font-size: 23rpx; }
.cat-switcher { display: flex; align-items: center; justify-content: space-between; padding: 18rpx 20rpx; border: 2rpx solid #fff; border-radius: 24rpx; background: rgba(255,255,255,.83); box-shadow: 0 10rpx 24rpx rgba(73,93,145,.1); }
.cat-current { display: flex; align-items: center; min-width: 0; }
.cat-current__avatar { width: 78rpx; height: 78rpx; border: 3rpx solid #fff; border-radius: 26rpx; background: #ffe27a; }
.cat-current__copy { display: flex; flex-direction: column; margin-left: 16rpx; }
.cat-current__label { color: #85899b; font-size: 19rpx; }
.cat-current__name { margin-top: 4rpx; color: #20243c; font-size: 30rpx; font-weight: 800; }
.switch-cat-button, .model-button { padding: 13rpx 16rpx; border-radius: 999rpx; background: #eef3ff; color: #2557d6; font-size: 21rpx; }
.switch-cat-button, .model-button { display: inline-flex; align-items: center; }
.model-button::after { border: 0; }
.dropdown-arrow { position: relative; display: inline-block; width: 22rpx; height: 14rpx; margin-left: 12rpx; flex: none; }
.dropdown-arrow::before, .dropdown-arrow::after { position: absolute; top: 5rpx; width: 13rpx; height: 3rpx; border-radius: 3rpx; background: #2557d6; content: ''; }
.dropdown-arrow::before { left: 0; transform: rotate(35deg); }
.dropdown-arrow::after { right: 0; transform: rotate(-35deg); }
.model-row { position: relative; display: flex; align-items: center; justify-content: space-between; margin-top: 16rpx; padding: 16rpx 20rpx; border-radius: 20rpx; background: rgba(255,255,255,.58); }
.model-row__copy { display: flex; flex-direction: column; }
.model-row__label { color: #85899b; font-size: 18rpx; }
.model-row__name { margin-top: 4rpx; color: #3d2a72; font-size: 23rpx; font-weight: 700; }
.model-button { border: 0; background: transparent; }
.model-menu { position: absolute; z-index: 8; top: 92rpx; right: 0; left: 0; padding: 18rpx; border: 2rpx solid #fff; border-radius: 22rpx; background: #fff; box-shadow: 0 18rpx 32rpx rgba(73,93,145,.18); }
.model-menu__title { margin-bottom: 10rpx; color: #85899b; font-size: 19rpx; }
.chat-quota-note { margin: 8rpx 20rpx 0; color: #8b93a9; text-align: right; font-size: 17rpx; }
.model-option { display: flex; align-items: center; justify-content: space-between; padding: 17rpx 12rpx; border-radius: 14rpx; color: #20243c; font-size: 23rpx; }
.model-option--active { background: #fff4d0; color: #3d2a72; font-weight: 700; }
.model-option__main { display: flex; align-items: center; }
.model-option__badge { min-width: 54rpx; margin-right: 8rpx; color: #f66e9c; font-size: 19rpx; }
.model-option__desc { color: #8b93a9; font-size: 18rpx; font-weight: 400; }
.message-scroll { flex: 1; height: auto; min-height: 0; margin-top: 18rpx; padding-bottom: 16rpx; box-sizing: border-box; }
.welcome-card { margin: 24rpx 8rpx; padding: 36rpx 28rpx 28rpx; border-radius: 28rpx; background: rgba(255,255,255,.72); text-align: center; }
.welcome-card__spark { color: #f66e9c; font-size: 38rpx; }
.welcome-card__title { display: block; margin-top: 6rpx; color: #3d2a72; font-size: 31rpx; font-weight: 800; }
.welcome-card__desc { display: block; margin-top: 12rpx; color: #75809a; font-size: 22rpx; line-height: 1.6; }
.persona-line { display: flex; justify-content: center; gap: 10rpx; margin-top: 20rpx; color: #5579b8; font-size: 20rpx; }
.persona-line text:first-child { color: #f66e9c; }
.quick-prompts { display: flex; justify-content: center; flex-wrap: wrap; gap: 10rpx; margin-top: 22rpx; }
.quick-prompts text { padding: 9rpx 15rpx; border-radius: 999rpx; background: #eef3ff; color: #5579b8; font-size: 19rpx; }
.message-group { display: block; }
.message-time { display: block; margin: 24rpx 0 8rpx; color: #9aa1b3; text-align: center; font-size: 17rpx; line-height: 1.4; }
.message-row { display: flex; align-items: flex-end; margin: 18rpx 4rpx; }
.message-row--user { justify-content: flex-end; }
.message-avatar { width: 54rpx; height: 54rpx; margin-right: 12rpx; border-radius: 18rpx; background: #ffe27a; }
.message-bubble { max-width: 73%; padding: 18rpx 22rpx; border-radius: 22rpx 22rpx 22rpx 6rpx; background: #fff; color: #20243c; font-size: 26rpx; line-height: 1.6; box-shadow: 0 6rpx 16rpx rgba(73,93,145,.08); }
.message-row--user .message-bubble { border-radius: 22rpx 22rpx 6rpx 22rpx; background: #2557d6; color: #fff; }
.message-bubble--pending { color: #7b84a0; }
.typing-dots { display: inline-flex; gap: 5rpx; margin-left: 8rpx; vertical-align: middle; }
.typing-dots i { width: 7rpx; height: 7rpx; border-radius: 50%; background: #f66e9c; }
.composer-wrap { position: relative; z-index: 10; flex: none; margin-top: 12rpx; padding: 0 0 calc(24rpx + env(safe-area-inset-bottom)); background: linear-gradient(180deg, rgba(248,247,251,.72), #f8f7fb 34%); }
.composer { display: flex; align-items: center; padding: 10rpx 12rpx 10rpx 22rpx; border: 3rpx solid #fff; border-radius: 999rpx; background: rgba(255,255,255,.94); box-shadow: 0 12rpx 28rpx rgba(73,93,145,.18); }
.composer__input { flex: 1; min-width: 0; height: 62rpx; color: #20243c; font-size: 25rpx; }
.send-button { display: flex; align-items: center; justify-content: center; width: 68rpx; height: 68rpx; padding: 0; border-radius: 50%; background: #dce4f7; color: #fff; font-size: 40rpx; line-height: 1; }
.send-button--ready { background: #f66e9c; }
.privacy-note { display: block; margin-top: 10rpx; color: #a0a6b6; text-align: center; font-size: 17rpx; }
