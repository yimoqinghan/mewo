page {
  min-height: 100%;
  background: linear-gradient(180deg, #b8d7ff 0, #eaf2ff 33%, #f8f7fb 64%);
  color: #20243c;
}

.trace-page {
  min-height: 100vh;
  padding: 28rpx 24rpx 80rpx;
  box-sizing: border-box;
}

.trace-hero {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 12rpx 8rpx 26rpx;
}

.trace-hero__eyebrow {
  display: block;
  color: #5b7bb6;
  font-size: 20rpx;
  letter-spacing: 4rpx;
}

.trace-hero__title {
  display: block;
  margin-top: 8rpx;
  color: #3d2a72;
  font-size: 40rpx;
  font-weight: 900;
  line-height: 1.2;
}

.trace-hero__desc {
  display: block;
  margin-top: 12rpx;
  color: #6f7897;
  font-size: 24rpx;
}

.trace-hero__stats {
  min-width: 104rpx;
  padding: 16rpx 18rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, .64);
  text-align: center;
}

.trace-hero__count,
.trace-hero__unit {
  display: block;
}

.trace-hero__count {
  color: #f15f93;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1;
}

.trace-hero__unit {
  margin-top: 6rpx;
  color: #77819a;
  font-size: 20rpx;
}

.map-card {
  position: relative;
  overflow: hidden;
  border: 3rpx solid rgba(255, 255, 255, .96);
  border-radius: 30rpx;
  background: #fff;
  box-shadow: 0 18rpx 40rpx rgba(72, 101, 160, .14);
}

.trace-map {
  display: block;
  width: 100%;
  height: 470rpx;
}

.map-locked {
  display: flex;
  height: 470rpx;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  background: linear-gradient(145deg, #edf4ff, #fdfaff);
}

.map-locked__icon {
  width: 104rpx;
  height: 104rpx;
}

.map-locked__title {
  margin-top: 12rpx;
  color: #3d2a72;
  font-size: 28rpx;
  font-weight: 800;
}

.map-locked__desc {
  margin-top: 8rpx;
  color: #85899b;
  font-size: 20rpx;
}

.map-empty {
  position: absolute;
  top: 140rpx;
  right: 0;
  left: 0;
  display: flex;
  align-items: center;
  flex-direction: column;
  pointer-events: none;
}

.map-empty__icon {
  width: 100rpx;
  height: 100rpx;
}

.map-empty__title {
  margin-top: 8rpx;
  color: #3d2a72;
  font-size: 30rpx;
  font-weight: 800;
}

.map-empty__desc {
  margin-top: 8rpx;
  color: #85899b;
  font-size: 22rpx;
}

.map-locate {
  position: absolute;
  right: 20rpx;
  bottom: 46rpx;
  padding: 12rpx 20rpx;
  border: 2rpx solid rgba(37, 87, 214, .12);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, .92);
  color: #2557d6;
  font-size: 22rpx;
  line-height: 1.2;
  box-shadow: 0 8rpx 18rpx rgba(72, 101, 160, .14);
}

.map-privacy {
  position: absolute;
  right: 20rpx;
  bottom: 16rpx;
  color: #85899b;
  font-size: 18rpx;
}

.trace-section {
  margin-top: 30rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx;
}

.section-head__title {
  display: block;
  color: #3d2a72;
  font-size: 32rpx;
  font-weight: 900;
}

.section-head__desc {
  display: block;
  margin-top: 6rpx;
  color: #85899b;
  font-size: 21rpx;
}

.section-head__action,
.record-empty__button {
  padding: 12rpx 20rpx;
  border: 2rpx solid rgba(246, 110, 156, .5);
  border-radius: 999rpx;
  background: #fff6fa;
  color: #f15f93;
  font-size: 22rpx;
  line-height: 1.2;
}

.filter-row {
  width: 100%;
  margin-top: 22rpx;
  white-space: nowrap;
}

.filter-pill {
  display: inline-block;
  margin-right: 12rpx;
  padding: 12rpx 22rpx;
  border: 2rpx solid #e6eaf5;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, .76);
  color: #77819a;
  font-size: 21rpx;
  line-height: 1.1;
}

.filter-pill--active {
  border-color: #f66e9c;
  background: #f66e9c;
  color: #fff;
}

.record-list {
  margin-top: 18rpx;
}

.record-card {
  display: flex;
  min-height: 174rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
  border: 3rpx solid rgba(255, 255, 255, .92);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, .9);
  box-shadow: 0 10rpx 24rpx rgba(72, 101, 160, .1);
}

.record-card__media {
  position: relative;
  width: 188rpx;
  flex: 0 0 188rpx;
  background: #eef3ff;
}

.record-card__image {
  display: block;
  width: 100%;
  height: 100%;
}

.record-card__image--video {
  padding: 42rpx;
  box-sizing: border-box;
}

.record-card__type {
  position: absolute;
  right: 10rpx;
  bottom: 10rpx;
  padding: 5rpx 10rpx;
  border-radius: 999rpx;
  background: rgba(32, 36, 60, .66);
  color: #fff;
  font-size: 17rpx;
}

.record-card__body {
  min-width: 0;
  flex: 1;
  padding: 24rpx 22rpx;
}

.record-card__topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.record-card__behavior {
  color: #3d2a72;
  font-size: 26rpx;
  font-weight: 800;
}

.record-card__date {
  color: #9aa1b5;
  font-size: 18rpx;
}

.record-card__location {
  display: block;
  margin-top: 18rpx;
  color: #5b7bb6;
  font-size: 21rpx;
}

.record-card__note {
  display: block;
  margin-top: 10rpx;
  overflow: hidden;
  color: #85899b;
  font-size: 20rpx;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-empty {
  margin-top: 18rpx;
  padding: 42rpx 30rpx;
  border: 3rpx dashed #dbe2f2;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, .6);
  text-align: center;
}

.record-empty__title,
.record-empty__desc {
  display: block;
}

.record-empty__title {
  color: #3d2a72;
  font-size: 27rpx;
  font-weight: 800;
}

.record-empty__desc {
  margin: 12rpx auto 22rpx;
  max-width: 500rpx;
  color: #85899b;
  font-size: 21rpx;
  line-height: 1.5;
}

.sheet-mask,
.detail-mask {
  position: fixed;
  z-index: 30;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(32, 36, 60, .32);
}

.composer-sheet {
  width: 100%;
  max-height: 88vh;
  overflow-y: auto;
  padding: 28rpx 28rpx calc(30rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  border-radius: 32rpx 32rpx 0 0;
  background: #f8f7fb;
}

.sheet-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.sheet-head__title {
  display: block;
  color: #3d2a72;
  font-size: 34rpx;
  font-weight: 900;
}

.sheet-head__desc {
  display: block;
  margin-top: 8rpx;
  color: #85899b;
  font-size: 20rpx;
}

.sheet-head__close {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #77819a;
  font-size: 20rpx;
  line-height: 1.1;
}

.media-actions {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  margin-top: 26rpx;
}

.media-action {
  min-height: 104rpx;
  padding: 20rpx 8rpx;
  border: 3rpx solid #e5eaf6;
  border-radius: 20rpx;
  background: #fff;
  color: #3d2a72;
  font-size: 23rpx;
  line-height: 1.2;
}

.media-action__hint {
  display: block;
  margin-top: 8rpx;
  color: #9aa1b5;
  font-size: 17rpx;
}

.media-preview {
  height: 180rpx;
  margin-top: 18rpx;
  overflow: hidden;
  border-radius: 20rpx;
  background: #e8efff;
}

.media-preview__image {
  display: block;
  width: 100%;
  height: 100%;
}

.media-preview__video,
.detail-card__video {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
  color: #3d2a72;
  font-size: 22rpx;
}

.media-preview__video-icon {
  width: 84rpx;
  height: 84rpx;
  margin-right: 12rpx;
}

.location-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding: 22rpx;
  border-radius: 20rpx;
  background: #fff;
}

.location-row__title,
.location-row__value {
  display: block;
}

.location-row__title {
  color: #3d2a72;
  font-size: 24rpx;
  font-weight: 800;
}

.location-row__value {
  margin-top: 7rpx;
  color: #85899b;
  font-size: 19rpx;
}

.location-row__button {
  padding: 13rpx 18rpx;
  border-radius: 999rpx;
  background: #edf3ff;
  color: #2557d6;
  font-size: 20rpx;
  line-height: 1.2;
}

.behavior-block {
  margin-top: 22rpx;
}

.form-label {
  display: block;
  color: #3d2a72;
  font-size: 24rpx;
  font-weight: 800;
}

.behavior-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}

.behavior-pill {
  padding: 10rpx 18rpx;
  border: 2rpx solid #e5eaf6;
  border-radius: 999rpx;
  background: #fff;
  color: #77819a;
  font-size: 20rpx;
  line-height: 1.2;
}

.behavior-pill--active {
  border-color: #f66e9c;
  background: #fff0f6;
  color: #f15f93;
}

.note-input {
  width: 100%;
  min-height: 100rpx;
  margin-top: 20rpx;
  padding: 20rpx;
  box-sizing: border-box;
  border: 3rpx solid #e5eaf6;
  border-radius: 20rpx;
  background: #fff;
  color: #20243c;
  font-size: 22rpx;
}

.save-button {
  margin-top: 22rpx;
  border-radius: 999rpx;
  background: #f66e9c;
  color: #fff;
  font-size: 27rpx;
  font-weight: 800;
}

.detail-mask {
  align-items: center;
  justify-content: center;
  padding: 30rpx;
  box-sizing: border-box;
}

.detail-card {
  width: 100%;
  overflow: hidden;
  padding-bottom: 24rpx;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 20rpx 60rpx rgba(32, 36, 60, .22);
}

.detail-card__handle {
  width: 70rpx;
  height: 8rpx;
  margin: 18rpx auto;
  border-radius: 999rpx;
  background: #dfe5f3;
}

.detail-card__image,
.detail-card__video-player {
  display: block;
  width: 100%;
  height: 360rpx;
  background: #edf3ff;
}

.detail-card__video-icon {
  width: 110rpx;
  height: 110rpx;
  margin-right: 14rpx;
}

.detail-card__behavior,
.detail-card__location,
.detail-card__note {
  display: block;
  margin-right: 28rpx;
  margin-left: 28rpx;
}

.detail-card__behavior {
  margin-top: 22rpx;
  color: #3d2a72;
  font-size: 30rpx;
  font-weight: 900;
}

.detail-card__location {
  margin-top: 10rpx;
  color: #5b7bb6;
  font-size: 20rpx;
}

.detail-card__note {
  margin-top: 14rpx;
  color: #85899b;
  font-size: 21rpx;
  line-height: 1.5;
}

.detail-card__nickname-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 16rpx 28rpx 0;
  padding: 14rpx 16rpx;
  border-radius: 16rpx;
  background: #fff7d7;
}

.detail-card__nickname {
  overflow: hidden;
  color: #8b6c23;
  font-size: 20rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.detail-card__nickname-row button {
  flex: 0 0 auto;
  margin-left: 12rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #c3912b;
  font-size: 19rpx;
  line-height: 1.2;
}

.detail-card__actions {
  display: flex;
  gap: 14rpx;
  margin: 24rpx 28rpx 0;
}

.detail-card__actions button {
  flex: 1;
  border-radius: 999rpx;
  background: #edf3ff;
  color: #2557d6;
  font-size: 21rpx;
}

.detail-card__actions .detail-card__delete {
  background: #fff0f4;
  color: #d35f82;
}

.nickname-mask {
  position: fixed;
  z-index: 45;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 34rpx;
  box-sizing: border-box;
  background: rgba(32, 36, 60, .34);
}

.nickname-card {
  width: 100%;
  padding: 30rpx;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 20rpx 60rpx rgba(32, 36, 60, .22);
}

.nickname-card__title,
.nickname-card__desc {
  display: block;
}

.nickname-card__title {
  color: #3d2a72;
  font-size: 30rpx;
  font-weight: 900;
}

.nickname-card__desc {
  margin-top: 8rpx;
  color: #85899b;
  font-size: 20rpx;
}

.nickname-card__input {
  width: 100%;
  height: 82rpx;
  margin-top: 24rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  border: 3rpx solid #e5eaf6;
  border-radius: 18rpx;
  background: #f8faff;
  color: #20243c;
  font-size: 23rpx;
}

.nickname-card__actions {
  display: flex;
  gap: 14rpx;
  margin-top: 22rpx;
}

.nickname-card__actions button {
  flex: 1;
  border-radius: 999rpx;
  background: #edf3ff;
  color: #2557d6;
  font-size: 21rpx;
}

.nickname-card__actions .nickname-card__save {
  background: #f66e9c;
  color: #fff;
}

.toast {
  position: fixed;
  z-index: 50;
  right: 50%;
  bottom: 50rpx;
  max-width: 80%;
  padding: 16rpx 24rpx;
  transform: translateX(50%);
  border-radius: 999rpx;
  background: rgba(32, 36, 60, .86);
  color: #fff;
  font-size: 21rpx;
}
