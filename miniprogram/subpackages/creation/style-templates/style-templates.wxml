<view class="style-page">
  <view class="style-sky"><view class="style-sun"></view><image src="{{assets.cloudSoft}}" mode="aspectFit" /></view>
  <view class="style-content">
    <view class="style-hero"><view><text class="hero-kicker">言喵 · AI 创作</text><text class="hero-title">找到你喜欢的画面感觉。</text><text class="hero-desc">每个模板都有示例图，选好后回到创作页即可使用。</text></view><image src="{{assets.menuCat}}" mode="aspectFit" /></view>
    <view class="style-summary"><view><text class="summary-title">我的常用风格</text><text class="summary-desc">至少保留一个，创作时可以随时切换</text></view><text class="summary-count">{{enabledCount}} 个已启用</text></view>
    <view class="style-list"><view wx:for="{{styles}}" wx:key="id" class="style-card {{item.enabled ? 'enabled' : ''}}"><view class="style-image-wrap" data-style="{{item.id}}" bindtap="previewStyle"><image class="style-image" src="{{item.example}}" mode="widthFix" bindload="onStyleImageLoad" data-style="{{item.id}}" /><view wx:if="{{!item.imageReady}}" class="template-loading-placeholder"><image src="{{assets.menuCat}}" mode="aspectFit" /><view class="template-loading-placeholder__glow"></view></view><view class="image-tip" aria-label="放大查看示例"></view></view><view class="style-info"><view><text class="style-name">{{item.name}}</text><text class="style-desc">{{item.desc}}</text></view><button class="style-toggle {{item.enabled ? 'on' : ''}}" data-style="{{item.id}}" bindtap="toggleStyle">{{item.enabled ? '已启用' : '启用'}}</button></view></view></view>
    <button class="done-button" bindtap="back">完成，回到创作</button>
  </view>
</view>
