.style-page{min-height:100vh;background:linear-gradient(180deg,#b8d7ff 0,#e9f3ff 330rpx,#f8f7fb 700rpx);color:#20243c}.style-sky{position:absolute;top:0;left:0;right:0;height:360rpx;pointer-events:none}.style-sky image{position:absolute;right:-70rpx;top:50rpx;width:300rpx;height:130rpx;opacity:.68}.style-sun{position:absolute;right:-105rpx;top:-70rpx;width:290rpx;height:290rpx;border-radius:50%;background:#ffe27a;opacity:.6}.style-content{position:relative;padding:18rpx 30rpx calc(48rpx + env(safe-area-inset-bottom))}.style-hero{display:flex;align-items:center;justify-content:space-between;min-height:185rpx}.hero-kicker{display:block;color:#647aa4;font-size:20rpx;letter-spacing:2rpx}.hero-title{display:block;max-width:490rpx;margin-top:12rpx;color:#3d2a72;font-size:36rpx;line-height:1.35;font-weight:900}.hero-desc{display:block;max-width:510rpx;margin-top:10rpx;color:#6d7693;font-size:20rpx;line-height:1.5}.style-hero image{width:138rpx;height:150rpx;margin-right:-18rpx}.style-summary{display:flex;align-items:center;justify-content:space-between;margin:18rpx 0;padding:22rpx;border:2rpx solid #fff;border-radius:22rpx;background:#ffffffdb;box-shadow:0 12rpx 30rpx #586c9b10}.summary-title{display:block;color:#3d2a72;font-size:24rpx;font-weight:800}.summary-desc{display:block;margin-top:6rpx;color:#85899b;font-size:17rpx}.summary-count{color:#b15c85;font-size:19rpx;font-weight:750}.style-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));align-items:start;gap:16rpx}.style-card{align-self:start;min-width:0;padding:10rpx;border:3rpx solid #fff;border-radius:20rpx;background:#ffffffdb;box-shadow:0 10rpx 26rpx #586c9b0d}.style-card.enabled{border-color:#f5a9c9}.style-image-wrap{position:relative;border-radius:14rpx;overflow:hidden;background:#f2f6ff}.style-image{display:block;width:100%;height:auto}.image-tip{position:absolute;right:8rpx;bottom:8rpx;width:42rpx;height:42rpx;padding:0;border-radius:50%;background:#20243cbb}.image-tip::before{content:"";position:absolute;top:8rpx;left:8rpx;width:14rpx;height:14rpx;border:3rpx solid #fff;border-radius:50%}.image-tip::after{content:"";position:absolute;top:24rpx;left:25rpx;width:10rpx;height:3rpx;border-radius:2rpx;background:#fff;transform:rotate(45deg);transform-origin:left center}.style-info{display:block;padding:10rpx 2rpx 2rpx}.style-name{display:block;color:#3d2a72;font-size:21rpx;font-weight:800;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.style-desc{display:block;margin-top:5rpx;color:#85899b;font-size:16rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.style-toggle{width:100%;height:48rpx;margin:10rpx 0 0;padding:0 8rpx;border:2rpx solid #dfe3ef;border-radius:25rpx;background:#f8f9fd;color:#707b98;font-size:17rpx;line-height:44rpx}.style-toggle::after{border:0}.style-toggle.on{border-color:#f5a9c9;background:#fff2f8;color:#a84f7a;font-weight:750}.done-button{width:100%;height:88rpx;margin-top:22rpx;border:3rpx solid #fff;border-radius:24rpx;background:#ffe27a;color:#3d2a72;font-size:25rpx;font-weight:850;box-shadow:0 7rpx 0 #edca6133}.done-button::after{border:0}@media(max-width:350px){.style-content{padding-left:24rpx;padding-right:24rpx}.hero-title{font-size:32rpx}}
.style-image-wrap{height:300rpx;box-sizing:border-box}.style-image{width:100%;height:100%;object-fit:cover}.template-loading-placeholder{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;overflow:hidden;background:linear-gradient(145deg,#edf4ff,#fff7fb)}.template-loading-placeholder image{position:relative;z-index:1;width:52%;height:52%;opacity:.82;animation:template-cat-breathe 1.5s ease-in-out infinite}.template-loading-placeholder__glow{position:absolute;width:46%;height:22%;bottom:18%;border-radius:50%;background:#9dbcf855;filter:blur(14rpx);animation:template-glow-pulse 1.5s ease-in-out infinite}@keyframes template-cat-breathe{0%,100%{transform:translateY(2rpx) scale(.96);opacity:.65}50%{transform:translateY(-3rpx) scale(1);opacity:1}}@keyframes template-glow-pulse{0%,100%{transform:scale(.82);opacity:.45}50%{transform:scale(1.05);opacity:.8}}
