.result-page{position:relative;min-height:100vh;background:linear-gradient(180deg,#b8d7ff 0,#ecf4ff 360rpx,#f8f7fb 780rpx);color:#3d2a72;overflow:hidden}.result-sky{position:absolute;inset:0 0 auto;height:390rpx;pointer-events:none}.result-sky image{position:absolute;right:-90rpx;top:80rpx;width:310rpx;height:120rpx;opacity:.7}.result-sun{position:absolute;right:-78rpx;top:10rpx;width:285rpx;height:285rpx;border-radius:50%;background:#ffe27a;opacity:.58}.result-content{position:relative;padding:28rpx 30rpx calc(48rpx + env(safe-area-inset-bottom))}.result-header{display:flex;align-items:center;gap:16rpx;min-height:100rpx}.result-header button{width:64rpx;height:64rpx;border:0;border-radius:50%;background:#fff;color:#3d2a72;font-size:50rpx;line-height:54rpx;padding:0}.result-header>view{flex:1}.result-header text{display:block}.result-header text:first-child{font-size:34rpx;font-weight:850}.result-header text:nth-child(2){font-size:20rpx;color:#7d86a0;margin-top:6rpx}.result-header>text{color:#efbd32;font-size:30rpx}.result-art{position:relative;height:690rpx;overflow:hidden;margin-top:18rpx;border:4rpx solid #fff;border-radius:36rpx;background:#edf4ff;box-shadow:0 18rpx 45rpx #5267ad1c}.result-art .checker{position:absolute;inset:0;background-color:#f5f8ff;background-image:linear-gradient(45deg,#e8eef8 25%,transparent 25%),linear-gradient(-45deg,#e8eef8 25%,transparent 25%),linear-gradient(45deg,transparent 75%,#e8eef8 75%),linear-gradient(-45deg,transparent 75%,#e8eef8 75%);background-size:44rpx 44rpx;background-position:0 0,0 22rpx,22rpx -22rpx,-22rpx 0}.result-art>image{position:relative;z-index:1;display:block;width:100%;height:100%;padding:30rpx}.private-badge{position:absolute;z-index:2;left:24rpx;bottom:22rpx;padding:10rpx 18rpx;border:2rpx solid #fff;border-radius:24rpx;background:#ffffffe8;color:#757e96;font-size:19rpx}.loading-state,.error-state{display:flex;align-items:center;justify-content:center;flex-direction:column;height:690rpx;margin-top:18rpx;border:3rpx solid #fff;border-radius:36rpx;background:#fff;color:#7d86a0;font-size:25rpx}.dot-loader{color:#f3be35;font-size:52rpx;animation:spin 1.2s linear infinite;margin-bottom:18rpx}@keyframes spin{to{transform:rotate(360deg)}}.error-state text{padding:0 42rpx;text-align:center;line-height:1.6}.error-state button{margin-top:28rpx;border:0;border-radius:24rpx;background:#ffe27a;color:#3d2a72;font-size:23rpx;line-height:76rpx}.result-copy{padding:26rpx 8rpx 8rpx}.result-copy text{display:block}.result-title{font-size:31rpx;font-weight:800}.result-desc{font-size:23rpx;line-height:1.7;color:#707a95;margin-top:10rpx}.result-meta{font-size:19rpx;color:#9aa1b3;margin-top:12rpx}.result-actions{display:flex;gap:16rpx;margin-top:18rpx}.result-actions button,.library-button{flex:1;margin:0;border-radius:26rpx;border:3rpx solid #fff;font-size:25rpx;font-weight:750;line-height:88rpx}.save-button{background:#ffe27a;color:#3d2a72}.share-button{background:#f5a9c9;color:#3d2a72}.library-button{width:100%;margin-top:16rpx;background:#fff;color:#3d2a72}.result-actions button::after,.library-button::after{border:0}.privacy-copy{display:block;text-align:center;color:#969bab;font-size:19rpx;line-height:1.7;margin:18rpx 22rpx 0}
.result-art>image { border-radius:10rpx; }
