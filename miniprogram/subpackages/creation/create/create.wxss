.reference-head { display:flex; align-items:flex-start; justify-content:space-between; gap:14rpx; margin:0 0 14rpx; }
.reference-actions { display:flex; gap:14rpx; margin-top:18rpx; }
.reference-action { display:flex!important; align-items:center; justify-content:flex-start!important; flex:1; min-width:0; height:94rpx!important; margin:0!important; padding:0 14rpx; border:2rpx solid #e7ebf5; border-radius:22rpx; background:#f8faff!important; color:#3d2a72; text-align:left; }
.reference-action::after { border:0; }
.reference-action--album { border-color:#f5c1d7; background:#fff5fa!important; }
.reference-action--camera { border-color:#cbdaf4; background:#f5f8ff!important; }
.reference-action image { flex:none; width:48rpx; height:48rpx; margin-right:10rpx; }
.reference-action view { min-width:0; flex:1; }
.reference-action view text { display:block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.reference-action view text:first-child { font-size:21rpx; font-weight:750; }
.reference-action view text:nth-child(2) { margin-top:4rpx; color:#85899b; font-size:15rpx; }
.reference-action__arrow { flex:none; margin-left:4rpx; color:#8a9bc0; font-size:34rpx; font-weight:300; }
