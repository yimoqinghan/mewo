<view class="bottom-nav">
  <view class="bottom-nav__item {{active === 'home' ? 'bottom-nav__item--active' : ''}}" bindtap="goHome">
    <image class="bottom-nav__icon" src="{{assets.home}}" mode="aspectFit" />
    <text class="bottom-nav__label">首页</text>
  </view>
  <view class="bottom-nav__item {{active === 'cats' ? 'bottom-nav__item--active' : ''}}" bindtap="goCats">
    <image class="bottom-nav__icon" src="{{assets.archive}}" mode="aspectFit" />
    <text class="bottom-nav__label">喵档案</text>
  </view>
  <view class="bottom-nav__create {{active === 'create' ? 'bottom-nav__create--active' : ''}}" bindtap="goCreate" aria-label="进入创作">
    <view class="bottom-nav__create-button">
      <image class="bottom-nav__create-icon" src="{{assets.create}}" mode="aspectFit" />
    </view>
    <text class="bottom-nav__create-label">喵创作</text>
  </view>
  <view class="bottom-nav__item {{active === 'works' ? 'bottom-nav__item--active' : ''}}" bindtap="goWorks">
    <image class="bottom-nav__icon" src="{{assets.works}}" mode="aspectFit" />
    <text class="bottom-nav__label">喵作</text>
  </view>
  <view class="bottom-nav__item {{active === 'mine' ? 'bottom-nav__item--active' : ''}}" bindtap="goMine">
    <image class="bottom-nav__icon" src="{{assets.mine}}" mode="aspectFit" />
    <text class="bottom-nav__label">我的</text>
  </view>
</view>
