.login-page{min-height:100vh;padding:24rpx 32rpx 64rpx;box-sizing:border-box;background:linear-gradient(180deg,#b8d7ff 0,#e8f2ff 48%,#f8f7fb 80%);color:#3d2a72;position:relative}.login-cloud{position:absolute;width:300rpx;height:140rpx;top:74rpx;right:-70rpx;opacity:.75}.login-cat{display:block;width:225rpx;height:270rpx;margin:8rpx auto -28rpx;position:relative;z-index:1}.login-card{position:relative;border:3rpx solid #fff;border-radius:40rpx;padding:48rpx 32rpx 16rpx;background:#ffffffed;box-shadow:0 18rpx 45rpx #5267ad16}.kicker{display:block;font-size:22rpx;color:#85899b;text-align:center}.login-title{display:block;font-size:42rpx;font-weight:800;margin:12rpx 0;text-align:center}.login-desc{display:block;font-size:23rpx;line-height:1.7;color:#85899b;text-align:center}.login-hint{display:block;font-size:22rpx;line-height:1.6;color:#85899b;margin:32rpx 4rpx 16rpx;text-align:center}.agreement{display:flex;align-items:center;min-height:88rpx;font-size:22rpx;line-height:1.6;color:#68697c;gap:12rpx}.check{width:30rpx;height:30rpx;border:2rpx solid #ccd6e7;border-radius:9rpx;text-align:center;line-height:30rpx;flex-shrink:0}.checked{background:#2557d6;color:white;border-color:#2557d6}.login-button{background:#ffe27a;color:#3d2a72;border-radius:28rpx;font-size:28rpx;font-weight:800;line-height:94rpx;border:3rpx solid white;box-shadow:0 8rpx 0 #edcb6033}.login-button::after,.browse-button::after{border:0}.login-button[disabled]{background:#f3eedb;color:#b0a995}.browse-button{font-size:23rpx;background:transparent;color:#85899b;margin:18rpx auto;line-height:72rpx}.login-error,.service-note{display:block;color:#b64c72;font-size:23rpx;line-height:1.6;margin-top:20rpx}.privacy-copy{padding:28rpx 16rpx;color:#85899b;font-size:20rpx;line-height:1.9}.privacy-title{display:block;color:#626981;font-weight:650;margin-bottom:12rpx}
