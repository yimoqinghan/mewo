.form-intro {
  margin-bottom: 26rpx;
}

.page-title {
  display: block;
  font-size: 42rpx;
  font-weight: 800;
}

.page-subtitle {
  display: block;
  margin-top: 10rpx;
  color: #85899b;
  font-size: 24rpx;
}

.avatar-picker {
  display: flex;
  align-items: center;
  padding: 22rpx;
  border-radius: 24rpx;
  background: #dcecff;
}

.avatar-picker image {
  width: 112rpx;
  height: 112rpx;
  margin-right: 22rpx;
  border-radius: 32rpx;
  background: #ffe27a;
}

.avatar-picker text {
  flex: 1;
  color: #5e6580;
  font-size: 22rpx;
  line-height: 1.5;
}

.photo-field { margin-top: 22rpx; padding: 24rpx; border: 3rpx solid #fff; border-radius: 24rpx; background: #fff; box-shadow: 0 10rpx 24rpx rgba(73,93,145,.08); }
.photo-field__head { display:flex; align-items:flex-start; justify-content:space-between; }
.photo-field__head .field__label { margin-bottom: 4rpx; }
.photo-field__hint { display:block; color:#85899b; font-size:19rpx; }
.photo-field__count { color:#2557d6; font-size:20rpx; font-weight:700; }
.photo-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:12rpx; margin-top:18rpx; }
.photo-tile, .photo-add { position:relative; display:flex; align-items:center; justify-content:center; width:100%; height:136rpx; padding:0; overflow:hidden; border:2rpx solid #eef0f8; border-radius:18rpx; background:#f5f7fd; }
.photo-tile image { width:100%; height:100%; }
.photo-tile--cover { border:4rpx solid #f66e9c; }
.photo-tile__cover { position:absolute; right:6rpx; bottom:6rpx; padding:4rpx 8rpx; border-radius:999rpx; background:#f66e9c; color:#fff; font-size:16rpx; }
.photo-tile__remove { position:absolute; top:4rpx; right:4rpx; display:flex; align-items:center; justify-content:center; width:38rpx; height:38rpx; padding:0; border-radius:50%; background:rgba(32,36,60,.72); color:#fff; font-size:26rpx; line-height:1; }
.photo-add { flex-direction:column; color:#5579b8; font-size:18rpx; }
.photo-add text:first-child { color:#f66e9c; font-size:38rpx; line-height:1; }
.photo-add--album { background:#eef5ff; }
.date-picker { display:flex; align-items:center; justify-content:space-between; min-height:64rpx; color:#9ca3b5; font-size:25rpx; }
.date-picker--filled { color:#20243c; }
.date-picker text { color:#2557d6; font-size:26rpx; }
.field--persona { margin-top: 4rpx; padding-top: 30rpx; }

.form-card {
  margin-top: 22rpx;
  padding: 4rpx 24rpx;
  border-radius: 24rpx;
  background: #ffffff;
}

.field {
  padding: 24rpx 0;
  border-bottom: 2rpx solid #f0f1f6;
}

.field:last-child {
  border-bottom: 0;
}

.field__label {
  display: block;
  margin-bottom: 12rpx;
  color: #20243c;
  font-size: 24rpx;
  font-weight: 700;
}
.field__required { margin-left:10rpx; color:#f66e9c; font-size:18rpx; font-weight:500; }

.field__input,
.field__textarea {
  width: 100%;
  color: #20243c;
  font-size: 26rpx;
}

.field__textarea {
  min-height: 120rpx;
  line-height: 1.5;
}

.save-button {
  margin-top: 28rpx;
}
.privacy-hint { display:block; margin:24rpx 16rpx 0; color:#85899b; text-align:center; font-size:20rpx; line-height:1.6; }
