.feedback-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: calc(env(safe-area-inset-top) + 28rpx) 28rpx calc(48rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, #b8d7ff 0, #eef5ff 34%, #f8f7fb 74%);
}

.feedback-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.feedback-back,
.feedback-topbar__spacer {
  width: 72rpx;
  height: 72rpx;
}

.feedback-back {
  margin: 0;
  padding: 0 0 8rpx;
  border: 3rpx solid #ffffff;
  border-radius: 50%;
  background: rgba(255, 255, 255, .84);
  color: #3d2a72;
  font-size: 54rpx;
  font-weight: 300;
  line-height: 60rpx;
  text-align: center;
}

.feedback-back::after { border: 0; }

.feedback-topbar > view:nth-child(2) { display: flex; align-items: center; flex-direction: column; }
.feedback-eyebrow { color: #65708c; font-size: 16rpx; letter-spacing: 3rpx; }
.feedback-title { margin-top: 4rpx; color: #3d2a72; font-size: 34rpx; font-weight: 850; }

.feedback-intro {
  margin-top: 28rpx;
  padding: 26rpx 28rpx;
  border: 3rpx solid #ffffff;
  border-radius: 26rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, .9), rgba(255, 248, 217, .82));
  box-shadow: 0 12rpx 26rpx rgba(73, 93, 145, .1);
}

.feedback-intro__title,
.feedback-intro__desc { display: block; }
.feedback-intro__title { color: #3d2a72; font-size: 30rpx; font-weight: 800; }
.feedback-intro__desc { margin-top: 8rpx; color: #747493; font-size: 21rpx; line-height: 1.5; }

.feedback-type-list { display: flex; gap: 16rpx; margin-top: 20rpx; }

.feedback-type {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: space-between;
  min-height: 112rpx;
  padding: 18rpx;
  border: 3rpx solid rgba(255, 255, 255, .9);
  border-radius: 22rpx;
  background: rgba(255, 255, 255, .72);
  box-shadow: 0 8rpx 18rpx rgba(73, 93, 145, .07);
}

.feedback-type.is-active { border-color: #f66e9c; background: #fff3f8; box-shadow: 0 0 0 4rpx rgba(246, 110, 156, .12); }
.feedback-type__title,
.feedback-type__desc { display: block; }
.feedback-type__title { color: #3d2a72; font-size: 23rpx; font-weight: 800; }
.feedback-type__desc { margin-top: 7rpx; color: #85899b; font-size: 17rpx; line-height: 1.35; }
.feedback-type__check { color: #f66e9c; font-size: 28rpx; font-weight: 800; }

.feedback-form-card {
  margin-top: 20rpx;
  padding: 24rpx 24rpx 8rpx;
  border: 3rpx solid #ffffff;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, .88);
  box-shadow: 0 12rpx 26rpx rgba(73, 93, 145, .09);
}

.feedback-field { position: relative; margin-bottom: 24rpx; }
.feedback-field--last { margin-bottom: 12rpx; }
.feedback-label { display: block; color: #3d2a72; font-size: 23rpx; font-weight: 750; }
.feedback-optional { margin-left: 8rpx; color: #a0a1b0; font-size: 17rpx; font-weight: 400; }
.feedback-required { margin-left: 8rpx; color: #f66e9c; font-size: 17rpx; font-weight: 400; }
.feedback-input,
.feedback-textarea { width: 100%; margin-top: 10rpx; padding: 18rpx; border: 2rpx solid #edf0f7; border-radius: 18rpx; background: #fafbff; color: #20243c; font-size: 21rpx; }
.feedback-input { height: 76rpx; }
.feedback-textarea { min-height: 178rpx; line-height: 1.55; }
.feedback-counter { display: block; margin-top: 6rpx; color: #a0a1b0; text-align: right; font-size: 16rpx; }

.feedback-upload {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 168rpx;
  height: 132rpx;
  margin-top: 10rpx;
  border: 2rpx dashed #c9cce0;
  border-radius: 18rpx;
  background: #fafbff;
  flex-direction: column;
}

.feedback-upload__plus { color: #8f92aa; font-size: 38rpx; line-height: 38rpx; }
.feedback-upload__text { margin-top: 6rpx; color: #85899b; font-size: 17rpx; }
.feedback-attachment { display: flex; align-items: center; margin-top: 10rpx; }
.feedback-attachment__image { width: 168rpx; height: 132rpx; border-radius: 18rpx; background: #eef0f8; }
.feedback-attachment__remove { margin: 0 0 0 16rpx; padding: 0 18rpx; border-radius: 999rpx; background: #fff0f5; color: #c55e88; font-size: 18rpx; line-height: 58rpx; }
.feedback-attachment__remove::after { border: 0; }

.feedback-privacy { margin: 18rpx 12rpx 0; color: #85899b; font-size: 17rpx; line-height: 1.5; }
.feedback-submit { width: 100%; height: 86rpx; margin: 24rpx 0 0; padding: 0; border-radius: 999rpx; background: #f66e9c; color: #ffffff; font-size: 26rpx; font-weight: 800; line-height: 86rpx; box-shadow: 0 10rpx 22rpx rgba(246, 110, 156, .22); }
.feedback-submit::after { border: 0; }
.feedback-submit[disabled] { opacity: .72; }

.feedback-success { margin-top: 80rpx; padding: 44rpx 28rpx; border: 3rpx solid #ffffff; border-radius: 30rpx; background: rgba(255, 255, 255, .9); text-align: center; box-shadow: 0 14rpx 30rpx rgba(73, 93, 145, .1); }
.feedback-success__badge { display: inline-flex; align-items: center; justify-content: center; min-width: 120rpx; height: 48rpx; border-radius: 999rpx; background: #fff0a9; color: #806c28; font-size: 19rpx; font-weight: 750; }
.feedback-success__title,
.feedback-success__desc { display: block; }
.feedback-success__title { margin-top: 18rpx; color: #3d2a72; font-size: 34rpx; font-weight: 850; }
.feedback-success__desc { margin-top: 10rpx; color: #747493; font-size: 21rpx; line-height: 1.6; }
.feedback-success__note { display: flex; margin-top: 24rpx; padding: 18rpx; border-radius: 18rpx; background: #f5f1ff; color: #777393; flex-direction: column; gap: 8rpx; font-size: 18rpx; line-height: 1.45; }
.feedback-secondary { width: 100%; height: 76rpx; margin: 16rpx 0 0; padding: 0; border: 3rpx solid #ffffff; border-radius: 999rpx; background: #ffffff; color: #3d2a72; font-size: 23rpx; line-height: 70rpx; }
.feedback-secondary::after { border: 0; }
