.module-card:nth-child(even) .module-card__copy { align-items: flex-start; margin-left: 0; text-align: left; }
.module-card:nth-child(even) .module-card__image { right: -12rpx; left: auto; }
.module-card__title { font-size: 34rpx; font-weight: 900; line-height: 1.1; letter-spacing: -1rpx; }
.module-card__subtitle { margin-top: 8rpx; color: #6b5c7d; font-size: 20rpx; line-height: 1.25; }
.module-card__image { position: absolute; z-index: 1; bottom: -10rpx; display: block; width: 206rpx; height: 196rpx; object-fit: contain; filter: drop-shadow(0 10rpx 12rpx rgba(82, 56, 112, .15)); }
.module-card__image--fallback, .submodule-card__image--fallback { opacity: .76; }
.submodule-grid { gap: 16rpx; }
.submodule-card { position: relative; display: flex; width: 100%; min-height: 244rpx; box-sizing: border-box; margin: 0; padding: 8rpx 14rpx 16rpx; overflow: hidden; flex-direction: column; align-items: center; border: 2rpx solid rgba(255, 255, 255, .86); border-radius: 32rpx 38rpx 30rpx 40rpx; background: rgba(255, 255, 255, .72); color: #30224f; text-align: center; box-shadow: 0 10rpx 18rpx rgba(87, 62, 119, .1), inset 0 2rpx 0 rgba(255, 255, 255, .92); }
.submodule-card--pink { border-color: rgba(240, 105, 166, .35); }
.submodule-card--rose { border-color: rgba(236, 107, 152, .3); }
.submodule-card--yellow { border-color: rgba(232, 176, 45, .35); }
.submodule-card--blue { border-color: rgba(91, 146, 222, .35); }
.submodule-card--purple { border-color: rgba(146, 106, 213, .32); }
.submodule-card--orange { border-color: rgba(229, 139, 72, .35); }
.submodule-card__image { display: block; width: 100%; height: 194rpx; object-fit: contain; filter: drop-shadow(0 7rpx 8rpx rgba(82, 56, 112, .12)); }
.submodule-card__copy { display: flex; width: 100%; min-width: 0; flex-direction: column; align-items: center; padding: 0; text-align: center; }
.submodule-card__title { max-width: 100%; overflow: hidden; font-size: 30rpx; font-weight: 900; line-height: 1.15; text-overflow: ellipsis; white-space: nowrap; }

@media (max-height: 680px) { .slogan { margin-top: 4rpx; font-size: 34rpx; } .cat-stage { top: 194rpx; bottom: 28vh; } .is-touch .cat-stage { bottom: 25vh; } .cat-figure--home, .cat-figure--blink-home { width: 530rpx; height: 706rpx; right: 72rpx; } .cat-figure--touch { width: 530rpx; height: 706rpx; right: 48rpx; } .cat-webgl { height: 734rpx; } .bottom-controls { bottom: calc(env(safe-area-inset-bottom) + 10vh); } .drawer-trigger { bottom: calc(env(safe-area-inset-bottom) + 10vh + 210rpx); } .camera-hint { bottom: calc(env(safe-area-inset-bottom) + 2.2vh); } }
