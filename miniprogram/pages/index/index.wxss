.module-card { position: relative; display: flex; width: 100%; height: 222rpx; box-sizing: border-box; margin: 0; padding: 22rpx 18rpx 18rpx 22rpx; overflow: hidden; flex-direction: column; align-items: flex-start; border: 2rpx solid rgba(255, 255, 255, .84); border-radius: 38rpx 48rpx 38rpx 48rpx; background: linear-gradient(145deg, rgba(255, 255, 255, .94), rgba(255, 247, 253, .68)); color: #2d2050; text-align: left; box-shadow: 0 12rpx 24rpx rgba(87, 62, 119, .12), inset 0 2rpx 0 rgba(255, 255, 255, .96); }
