.menu-item--blue { border-radius: 56rpx 70rpx 80rpx 58rpx; transform: translateY(-3rpx) rotate(-.6deg); }
.menu-item--rose { border-radius: 70rpx 56rpx 60rpx 82rpx; transform: translateY(4rpx) rotate(.6deg); }
.menu-item--purple { border-radius: 60rpx 80rpx 56rpx 72rpx; transform: rotate(-.7deg); }
