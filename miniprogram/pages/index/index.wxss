.photo-preview__header { display: flex; align-items: center; justify-content: space-between; padding: 24rpx 28rpx; color: #2a1e3b; font-size: 30rpx; font-weight: 900; }
.photo-preview__close { width: 52rpx; height: 52rpx; margin: 0; padding: 0; border: 0; background: transparent; font-size: 44rpx; line-height: 1; }
.photo-preview__image { display: block; width: 100%; height: 540rpx; background: #e6f2ff; }
.photo-preview__confirm { width: calc(100% - 48rpx); margin: 24rpx; border: 0; border-radius: 28rpx; background: #ffd62c; color: #22172f; font-size: 28rpx; font-weight: 900; line-height: 86rpx; }
.toast { position: absolute; z-index: 30; top: 170rpx; left: 50%; padding: 16rpx 28rpx; border-radius: 40rpx; background: #2b1d3b; color: #fff; font-size: 22rpx; transform: translateX(-50%); }

@keyframes ring-pop { 0% { opacity: .9; transform: translate(-50%, -50%) scale(.45); } 100% { opacity: 0; transform: translate(-50%, -50%) scale(1.5); } }
@keyframes cloud-drift-left { 0%, 100% { transform: translate3d(-18rpx, 0, 0) scale(.82); opacity: .78; } 50% { transform: translate3d(86rpx, -12rpx, 0) scale(.86); opacity: .98; } }
@keyframes cloud-drift-right { 0%, 100% { transform: translate3d(16rpx, 0, 0) scale(.64); opacity: .8; } 50% { transform: translate3d(-62rpx, 10rpx, 0) scale(.7); opacity: 1; } }
@keyframes cat-idle-breathe { 0%, 100% { transform: translate3d(0, 0, 0) scale(1); } 35% { transform: translate3d(0, -2rpx, 0) scale(1.004); } 70% { transform: translate3d(0, -4rpx, 0) scale(1.008); } }
@keyframes cat-touch-reaction { 0% { transform: translate3d(0, 8rpx, 0) scale(.99); filter: drop-shadow(0 16rpx 15rpx rgba(79, 51, 93, .13)); } 42% { transform: translate3d(0, 0, 0) scale(1.012); filter: drop-shadow(0 20rpx 18rpx rgba(79, 51, 93, .2)); } 100% { transform: translate3d(0, 0, 0) scale(1); filter: drop-shadow(0 18rpx 16rpx rgba(79, 51, 93, .17)); } }
@keyframes cat-menu-peek { 0% { opacity: 0; transform: translate3d(0, 34rpx, 0) scale(.94); } 100% { opacity: 1; transform: translate3d(0, 0, 0) scale(1); } }
@keyframes menu-rise-in { 0% { opacity: .3; transform: translate3d(0, 90rpx, 0); } 100% { opacity: 1; transform: translate3d(0, 0, 0); } }
@keyframes speech-in { 0% { opacity: 0; transform: rotate(7deg) scale(.84); } 100% { opacity: 1; transform: rotate(7deg) scale(1); } }
@keyframes hand-in { 0% { opacity: 0; transform: rotate(-7deg) translate3d(22rpx, 20rpx, 0) scale(.94); } 100% { opacity: 1; transform: rotate(-7deg) translate3d(0, 0, 0) scale(1); } }
@keyframes hand-press { 0%, 100% { transform: rotate(-7deg) translate3d(0, 0, 0); } 50% { transform: rotate(-7deg) translate3d(-8rpx, -8rpx, 0); } }
@keyframes hand-poke-smooth { 0%, 13% { opacity: 0; transform: rotate(-7deg) translate3d(22rpx, 22rpx, 0) scale(.94); } 28% { opacity: 1; transform: rotate(-7deg) translate3d(8rpx, 8rpx, 0) scale(.98); } 46% { transform: rotate(-7deg) translate3d(-8rpx, -8rpx, 0) scale(1); } 58% { transform: rotate(-7deg) translate3d(-3rpx, -3rpx, 0) scale(.985); } 76%, 100% { opacity: 1; transform: rotate(-7deg) translate3d(0, 0, 0) scale(1); } }
@keyframes intro-hand-poke { 0%, 100% { opacity: .9; transform: rotate(-7deg) translate3d(18rpx, 18rpx, 0) scale(.94); } 45% { opacity: 1; transform: rotate(-7deg) translate3d(-4rpx, -6rpx, 0) scale(1); } 62% { transform: rotate(-7deg) translate3d(5rpx, 2rpx, 0) scale(.97); } }

/* P0.5 模块入口重构：一级模块与子模块分层，入口视觉全部使用图片资产。 */
