.menu-item::before { position: absolute; top: 12rpx; left: 18%; width: 48%; height: 18rpx; border-radius: 50%; background: rgba(255, 255, 255, .42); content: ''; filter: blur(8rpx); transform: rotate(-6deg); pointer-events: none; }
