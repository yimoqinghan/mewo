# ============================================================
# 言喵后端环境变量模板
# 复制为 .env 后填写真实值。.env 已被 .gitignore 忽略，禁止提交。
# ============================================================

NODE_ENV=development
PORT=3000
# 生产环境由 Nginx 反代，服务只监听回环地址
HOST=127.0.0.1
LOG_LEVEL=info
PUBLIC_BASE_URL=https://api.your-domain.com

# ---------- 鉴权 ----------
# 生成方式：node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_ACCESS_TTL=2h
REFRESH_TTL_DAYS=30

# 允许的跨域来源，逗号分隔；小程序无 Origin 不受影响，主要给 H5 用
CORS_ORIGINS=https://h5.your-domain.com

# ---------- 数据库 ----------
DATABASE_URL=postgres://yanmiao:CHANGE_ME@127.0.0.1:5432/yanmiao
DB_POOL_MAX=5

# ---------- 微信小程序 ----------
WX_MP_APPID=
WX_MP_SECRET=
# trial 用于体验版/开发版，release 用于线上正式版
WX_MP_ENV_VERSION=trial

# ---------- 抖音小程序 ----------
DY_MP_APPID=
DY_MP_SECRET=

# ---------- 腾讯云 COS（私有读写） ----------
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=yanmiao-1250000000
COS_REGION=ap-shanghai
# 静态品牌资源与用户媒体统一走 CDN 加速域名
# 例如 https://static.missmeow.net（需先在腾讯云 CDN 绑定 COS 源站）
COS_CDN_DOMAIN=
# 所有已就绪用户媒体是否走 CDN。true 的前提是 CDN 已完成私有桶回源授权，
# 否则未开放读权限的 u/ 对象经 CDN 会返回 403。
COS_CDN_PUBLIC_MEDIA=false
# 签名 URL 有效期（秒）
COS_SIGN_TTL=900
# COS 中静态资源的对象前缀
STATIC_ASSETS_PREFIX=static
# 静态资源已由 npm run sync:assets 上传 COS，且 CDN/源站验证通过后再开启
STATIC_ASSETS_FROM_COS=false

# ---------- AI 生成（火山方舟） ----------
# mock：本地占位；openai：OpenAI Images API；ark：火山方舟
AI_PROVIDER=mock
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
# 可选模型白名单，逗号分隔；客户端会在 AI 生图时展示并允许选择
OPENAI_IMAGE_MODELS=gpt-image-2.5-sunburst
OPENAI_IMAGE_MODEL_LABELS=GPT Image
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_PROTOCOL=auto
OPENAI_GIF_MODEL=tt-image-2.6

# 视频模型（默认复用灵泉兼容 OpenAI 配置；API Key 只放服务端）
VIDEO_BASE_URL=https://api.lk888.ai/v1
VIDEO_API_KEY=
VIDEO_MODEL=minimax-h3
VIDEO_MODEL_IDS=minimax-h3,hailuo-h3-cankaosheng,seedance-2.5-guanfang-anmiao,hailuo-h3-quannengcankao,video-enhance
VIDEO_MODEL_LABELS=MiniMax H3,海螺 H3 参考生,SD 2.5 满血版按秒,海螺 H3 全能参考,视频超分
VIDEO_TIMEOUT_MS=3600000
VIDEO_HLS_ENABLED=true
FFMPEG_PATH=ffmpeg
VIDEO_HLS_SEGMENT_SECONDS=1
VIDEO_HLS_TIMEOUT_MS=180000
# 灵泉 AI 提供 OpenAI Images 兼容接口时，可改为以下配置（密钥仍只放服务端）
# OPENAI_BASE_URL=https://api.lk888.ai/v1
# OPENAI_API_KEY=灵泉控制台创建的 API Key
# OPENAI_IMAGE_MODEL=tt-image-2.6
# 灵泉图片模型全量白名单（当前文档中的 26 个模型）
# OPENAI_IMAGE_MODELS=tt-image-2.5,tt-image-2.5-token,tt-image-2,tt-image-2.6,tt-image-2.6-guan,minimax-h3-image,muse-image,doubao-seedream-5-5-261028,banana-2.1,banana-2.1-token,tt-image-2-token,banana-pro,banana-2,doubao-seedream-5-0-pro-260628,banana-pro-token,gk-image-2.0,banana-2-token,mj_imagine,vidu-image-2,doubao-seedream-5-0-260128,wan2.7-image,doubao-seedream-4-5-251128,kling-v3-omni,qwen-image,wan2.6-image,kling-v3
# 不填 LABELS 时客户端直接显示模型 ID；需要中文名称时按同样顺序填写逗号分隔的标签
# OPENAI_IMAGE_MODEL_LABELS=TT Image 2.5,TT Image 2.5 官转,TT Image 2,TT Image 2.6,TT Image 2.6 官转,MiniMax H3 图像,Muse Image,即梦 5.5,纳米香蕉 2.1,纳米香蕉 2.1 官转,TT Image 2 官转,纳米香蕉 Pro,纳米香蕉 2,即梦 5.0 Pro,纳米香蕉 Pro Token版,GK Image 2.0,纳米香蕉 2 Token版,Midjourney,VIDU Image 2,即梦 5.0,万相 2.7 图像,即梦 4.5,可灵 V3 Omni,千问 Image Max,万相 2.6 图像,可灵 V3
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_API_KEY=
# 具体模型 ID 以火山方舟控制台「在线推理」列表为准
ARK_IMAGE_MODEL=doubao-seedream-4-0-250828
AI_TIMEOUT_MS=180000

# ---------- 免费额度 ----------
# 聊天和生图分开计数；VIP 账号不受这两个每日额度限制。
IMAGE_DAILY_FREE_LIMIT=3
CHAT_DAILY_FREE_LIMIT=30

# ---------- 真实人猫聊天模型 ----------
# 使用 OpenAI Chat Completions 兼容接口；密钥只放服务端。
CHAT_BASE_URL=https://your-chat-provider.example/v1
CHAT_API_KEY=
# 默认对应前端展示的榜单前 6；这里填写 api.lk888.ai 可直接调用的真实模型 ID。
CHAT_MODEL_IDS=kimi-k3,tt-6-luna,qwen4-max,hy4-flash,kimi-k3.1-pro,deepseek-v4.1-flash
CHAT_MODEL_LABELS=Kimi K3,混元 4,千问 4 Max,混元 4 Flash,Kimi K3.1 Pro,DS-V4.1-Flash

# ---------- 真实 GIF / 图生视频模型 ----------
# POST MEDIA_BASE_URL + MEDIA_GIF_PATH，返回 output_url/video_url 或可轮询的 id。
MEDIA_BASE_URL=https://your-media-provider.example/v1
MEDIA_API_KEY=
MEDIA_GIF_PATH=/videos/generations
MEDIA_GIF_STATUS_PATH=/videos
MEDIA_GIF_MODEL=
MEDIA_TIMEOUT_MS=180000

# ---------- 成本控制 ----------
# 每个用户每日免费生成次数
DAILY_FREE_LIMIT=3

# ---------- 任务队列 ----------
WORKER_CONCURRENCY=1
WORKER_POLL_MS=1500
# 单任务锁超时，超过则视为 worker 崩溃并回收
WORKER_LOCK_TIMEOUT_MS=3900000

# 宠物贴纸本地抠图；默认使用 server/.venv-sticker/bin/python 与 server/.models
STICKER_MODEL=u2net
STICKER_TIMEOUT_MS=120000
# STICKER_PYTHON=/absolute/path/to/python
# STICKER_MODEL_DIR=/absolute/path/to/models
